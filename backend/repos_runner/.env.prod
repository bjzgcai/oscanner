# Production repos_runner Docker execution profile
REPOS_RUNNER_EXECUTOR=docker
REPOS_RUNNER_DOCKER_CPUS=4
REPOS_RUNNER_DOCKER_MEMORY=16g

# Production queue capacity: one container consumes the whole 4-vCPU/16GB host.
REPOS_RUNNER_MAX_CONCURRENT_JOBS=1
REPOS_RUNNER_MAX_PENDING_JOBS=100

# Remote repos_runner service profile
REPOS_RUNNER_SERVER_OS="Ubuntu 22.04 64 bit"
REPOS_RUNNER_SERVER_BANDWIDTH="5 Mbps (Peak Bandwidth)"

# Internal GLM primary with OpenRouter DeepSeek fallback.
# API keys belong in the git-ignored .env.local file.
OSCANNER_LLM_BASE_URL=https://llm.inner.bza.edu.cn/hub/v1
OSCANNER_LLM_CHAT_COMPLETIONS_URL=https://llm.inner.bza.edu.cn/hub/v1/chat/completions
OSCANNER_LLM_MODEL=glm
OSCANNER_LLM_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash-1017
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
REPOS_RUNNER_LLM_MODEL=glm
REPOS_RUNNER_OPENCODE_MODEL=oscanner-internal/glm
REPOS_RUNNER_RUNTIME_COMPAT_MODEL=glm

OSCANNER_LOG_DIR=/data/logs/oscanner
