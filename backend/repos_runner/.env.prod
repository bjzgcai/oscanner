# Production repos_runner Docker execution profile
REPOS_RUNNER_EXECUTOR=docker
REPOS_RUNNER_DOCKER_CPUS=4
REPOS_RUNNER_DOCKER_MEMORY=16g

# Production queue capacity: one container consumes the whole 4-vCPU/16GB host.
REPOS_RUNNER_MAX_CONCURRENT_JOBS=1
REPOS_RUNNER_MAX_PENDING_JOBS=100

# Remote repos_runner service profile
REPOS_RUNNER_SERVER_OS="Ubuntu 22.04 64 bit"
REPOS_RUNNER_SERVER_BANDWIDTH="5 Mbps (Peak Bandwidth)"

# OpenRouter model routing for production runner LLM calls.
# deepseek/deepseek-v4-pro can return thinking-only blocks on OpenRouter's
# Anthropic-compatible endpoint, so keep qwen/qwen3.6-plus as the text fallback.
OPEN_ROUTER_PRIMARY_MODEL=deepseek/deepseek-v4-pro
OPEN_ROUTER_FALLBACK_MODEL=qwen/qwen3.6-plus
REPOS_RUNNER_LLM_MODEL=deepseek/deepseek-v4-pro
REPOS_RUNNER_RUNTIME_COMPAT_MODEL=deepseek/deepseek-v4-pro
