# Repository Runner Environment Configuration Template
# Copy this file to .env and replace placeholder values

# LLM configuration: internal GLM primary, OpenRouter DeepSeek fallback

OSCANNER_LLM_API_KEY=your_internal_gateway_key
OSCANNER_LLM_BASE_URL=https://llm.inner.bza.edu.cn/hub/v1
OSCANNER_LLM_CHAT_COMPLETIONS_URL=https://llm.inner.bza.edu.cn/hub/v1/chat/completions
OSCANNER_LLM_MODEL=glm
OSCANNER_LLM_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash-1017
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
OPEN_ROUTER_KEY=sk-or-v1-your-openrouter-key
REPOS_RUNNER_LLM_MODEL=glm
REPOS_RUNNER_OPENCODE_MODEL=oscanner-internal/glm

# Optional platform API tokens
GITEE_TOKEN=your-gitee-token
GITHUB_TOKEN=your-github-token
