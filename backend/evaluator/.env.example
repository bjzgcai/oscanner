# Server Configuration
# Port for the FastAPI evaluator server (default: 8000)
PORT=8000

# LLM provider: internal OpenAI-compatible gateway (primary).
OSCANNER_LLM_API_KEY=your_internal_gateway_key
OSCANNER_LLM_BASE_URL=https://llm.inner.bza.edu.cn/hub/v1
OSCANNER_LLM_CHAT_COMPLETIONS_URL=https://llm.inner.bza.edu.cn/hub/v1/chat/completions
OSCANNER_LLM_MODEL=glm
OSCANNER_LLM_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash-1017

# OpenRouter credentials for OpenRouter-backed helpers and the repository runner.
# Get your API key from: https://openrouter.ai/keys
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
OPEN_ROUTER_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gitee Access Tokens
# Generate tokens from: https://gitee.com/profile/personal_access_tokens

# Enterprise Gitee (z.gitee.cn) Access Token
GITEE_TOKEN=your_enterprise_gitee_token_here
GITHUB_TOKEN=your_github_token_here

# Optional fallback GitHub token. Used automatically when GITHUB_TOKEN runs out
# of API rate limit (quota), before falling back to waiting for a reset.
# Add GITHUB_TOKEN3, GITHUB_TOKEN4, ... for additional fallbacks.
GITHUB_TOKEN2=

# Optional local daily provider quota guard.
# 0 means disabled. GitHub GraphQL is counted in local estimated points.
OSCANNER_GITHUB_REST_DAILY_BUDGET=0
OSCANNER_GITHUB_GRAPHQL_DAILY_POINT_BUDGET=0
OSCANNER_GITEE_DAILY_REQUEST_BUDGET=0
OSCANNER_GITHUB_GRAPHQL_DEFAULT_QUERY_COST=1
