    "description": "Clone public GitHub and Gitee repositories, generate repository overviews, detect test commands, execute controlled test workflows, and expose reports and runtime evidence artifacts.",
    "license": {
      "name": "Apache-2.0"
    },
    "version": "0.1.6"
  },
